# ServiceNow instance
SN_INSTANCE_URL=https://yourcompany.service-now.com

# Basic authentication
SN_USERNAME=your_username
SN_PASSWORD=your_password

# OAuth2 client credentials (use instead of the basic pair above)
# SN_OAUTH_CLIENT_ID=
# SN_OAUTH_CLIENT_SECRET=
# SN_OAUTH_TOKEN_URL=https://yourcompany.service-now.com/oauth_token.do

# A Scripted REST API on the instance that executes server-side script.
# ServiceNow documents no public endpoint that runs arbitrary script.
# SN_SCRIPTED_REST_URL=/api/sn_gsc/v1/execute

# Safety
# SN_READ_ONLY=false
# SN_ALLOWED_TABLES=incident,change_request,cmdb_ci
# SN_DENIED_TABLES=sys_user
# SN_REQUIRE_CONFIRM=true
# SN_MAX_BATCH=100

# Local store and transport
# SN_STORE_PATH=~/.hermes/data/snowmcp/store.sqlite3
# SN_TIMEOUT=60
# SN_MAX_BYTES=8388608
